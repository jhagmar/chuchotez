#!/bin/sh
# Format the workspace so a commit matches `cargo fmt --all -- --check` in CI.

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo is required to format Rust sources" >&2
  exit 1
fi

cargo fmt --all

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | git add --pathspec-from-file=-
fi
